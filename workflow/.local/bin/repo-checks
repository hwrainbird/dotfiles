#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["rich"]
# ///
"""repo-checks — stamp the standard enforcement layer into a git repo.

Detects the repo's language and installs a pre-commit dispatch hook, a linter
config, and a GitHub Actions CI workflow. Secret scanning is already handled by
the machine-global git hook (~/.config/git/hooks/pre-commit), so this adds only
lint/format (+ build/tests) and CI.

    repo-checks <path>                   # dry run: show the plan
    repo-checks <path> --apply           # write the files
    repo-checks <path> --apply --force   # overwrite existing files too

Templates live in $XDG_DATA_HOME/repo-checks/templates/{python,js}/ (installed via
the dotfiles `workflow` stow package).
"""

from __future__ import annotations

import argparse
import os
import stat
from pathlib import Path

from rich.console import Console
from rich.table import Table

console = Console()

TEMPLATE_ROOT = (
    Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share"))
    / "repo-checks"
    / "templates"
)

# template filename in the language dir -> destination path within the repo.
LAYOUT: dict[str, dict[str, str]] = {
    "python": {
        "pre-commit": ".hooks/pre-commit",
        "pre-commit-config.yaml": ".pre-commit-config.yaml",
        "ruff.toml": "ruff.toml",
        "ci.yml": ".github/workflows/ci.yml",
    },
    "js": {
        "pre-commit": ".hooks/pre-commit",
        "biome.json": "biome.json",
        "ci.yml": ".github/workflows/ci.yml",
    },
}


def detect_language(repo: Path) -> str | None:
    """Pure: return 'python', 'js', or None from marker files in the repo root."""
    if (repo / "pyproject.toml").exists() or (repo / "requirements.txt").exists():
        return "python"
    if (repo / "package.json").exists():
        return "js"
    return None


def _make_executable(path: Path) -> None:
    """chmod +x — the global hook execs .hooks/pre-commit, so it needs the bit."""
    path.chmod(path.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)


def stamp(repo: Path, lang: str, *, apply: bool, force: bool) -> list[tuple[str, str]]:
    """Write (or plan) each template into the repo. Returns [(dest, action)]."""
    results: list[tuple[str, str]] = []
    for src_name, dest_rel in LAYOUT[lang].items():
        dest = repo / dest_rel
        if dest.exists() and not force:
            results.append((dest_rel, "skip"))
            continue
        verb = "overwrite" if dest.exists() else "create"
        if apply:
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_text((TEMPLATE_ROOT / lang / src_name).read_text())
            if dest.name == "pre-commit":
                _make_executable(dest)
        results.append((dest_rel, verb if apply else f"would {verb}"))
    return results


def main() -> int:
    ap = argparse.ArgumentParser(description="Stamp lint + CI checks into a repo.")
    ap.add_argument("repo", nargs="?", default=".", help="repo path (default: cwd)")
    ap.add_argument("--apply", action="store_true", help="write files (default: dry run)")
    ap.add_argument("--force", action="store_true", help="overwrite files that already exist")
    args = ap.parse_args()

    repo = Path(args.repo).resolve()
    if not (repo / ".git").is_dir():
        console.print(f"[red]Not a git repo:[/] {repo}")
        return 1
    if not TEMPLATE_ROOT.is_dir():
        console.print(f"[red]Templates not found:[/] {TEMPLATE_ROOT} — stow the `workflow` package?")
        return 1

    lang = detect_language(repo)
    if lang is None:
        console.print(f"[red]Unknown language[/] (no pyproject/requirements/package.json) in {repo}")
        return 1

    console.print(f"\n[bold]{repo.name}[/]  →  language [cyan]{lang}[/]")
    results = stamp(repo, lang, apply=args.apply, force=args.force)

    colour = {"create": "green", "overwrite": "yellow", "skip": "dim"}
    table = Table("File", "Action")
    for dest_rel, action in results:
        table.add_row(dest_rel, f"[{colour.get(action.replace('would ', ''), 'white')}]{action}[/]")
    console.print(table)

    if not args.apply:
        console.print("[dim]dry run — nothing written. Add --apply to write (--force to overwrite).[/]")
    else:
        console.print(f"[green]done.[/] next: [bold]cd {repo}[/] && pre-commit autoupdate && "
                      "pre-commit run --all-files")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
